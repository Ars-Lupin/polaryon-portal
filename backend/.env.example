FRONTEND_URL=http://localhost:3050
PORT=3333

# Gere valores aleatórios próprios (ex: openssl rand -base64 32) — nunca reutilize os deste arquivo.
JWT_SECRET=troque-por-um-segredo-aleatorio
MFA_CODE_SECRET=troque-por-outro-segredo-aleatorio

# Envio de código MFA por e-mail (necessário apenas se for usar o método EMAIL;
# para testar localmente sem configurar SMTP, use o método AUTHENTICATOR/TOTP)
SMTP_PROVEDOR=GMAIL
SMTP_USER=seu-email@gmail.com
SMTP_APP_PASSWORD=senha-de-app-do-gmail
SMTP_FROM_NAME=Polaryon

AUTHENTICATOR_ISSUER=Polaryon
